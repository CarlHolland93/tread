# Copy this file to `.env.local` and paste your Anthropic API key in.
# Used by the live shoe-scan vision pipeline (src/lib/vision/analyseShoe.ts).
# Get one at: https://console.anthropic.com/settings/keys
#
# Note: this key ships to the browser in dev — fine for local prototype use
# over your LAN, but never commit `.env.local` or expose the dev URL publicly.
VITE_ANTHROPIC_API_KEY=sk-ant-...
